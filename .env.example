# Copy to .env and fill in. The real .env is gitignored.

# From @BotFather. Treat as a password: it is a bearer credential with no second factor.
TELEGRAM_BOT_TOKEN=

# Which TON network to run against.
# Mainnet: https://tonapi.io   Testnet: https://testnet.tonapi.io
TONAPI_BASE_URL=https://tonapi.io

# Optional: raises the TonAPI rate limit. Get one at https://tonconsole.com
# TONAPI_KEY=

# How often the poller checks for payments. 10s feels immediate and stays inside the
# anonymous rate limit for a few creators; raise it, or set TONAPI_KEY, before pointing
# many creators at one deployment.
# TIP_POLL_SEC=10

# Storage. SQLite is fine on a VPS with a persistent volume. On an ephemeral cloud
# host use Postgres instead, or the database is wiped on every redeploy - taking the
# creator wallet mappings and the double-payout guard with it.
TIPBOT_JDBC_URL=jdbc:sqlite:tipbot.db
# TIPBOT_JDBC_URL=jdbc:postgresql://host:5432/tipbot
# TIPBOT_JDBC_USER=
# TIPBOT_JDBC_PASSWORD=
